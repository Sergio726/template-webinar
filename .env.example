# ---------------------------------------------------------------------------
# Copia este archivo a .env.local y completa los valores.
# .env.local esta en .gitignore: nunca subas credenciales al repositorio.
# ---------------------------------------------------------------------------

# URL publica del sitio. La usan los metadatos, el sitemap y las imagenes de
# compartir, que necesitan direcciones absolutas.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Destino de los registros. Puede ser n8n, Make, Zapier, un Apps Script de
# Google o tu propio backend: lo unico que hace la plantilla es un POST con un
# JSON. Solo existe en el servidor, asi que nunca llega al navegador.
REGISTRATION_WEBHOOK_URL=

# Opcional: si lo defines, cada envio viaja con "Authorization: Bearer <valor>"
# para que el receptor pueda verificar que la peticion es tuya.
WEBHOOK_SECRET=

# Opcional: milisegundos antes de abandonar el envio al webhook (por defecto 8000).
WEBHOOK_TIMEOUT_MS=8000

# Opcional: sal para anonimizar la IP en el limitador de envios.
RATE_LIMIT_SALT=

# Si distintos eventos van a destinos distintos, declara una variable por
# evento y nombrala en su config con integration.webhookEnvVar.
# REGISTRATION_WEBHOOK_URL_MI_WEBINAR=
